# AroFlo API credentials - from AroFlo Site Admin > Settings > General > AroFlo API
AROFLO_API_BASE_URL=https://api.aroflo.com/
AROFLO_SECRET_KEY=
AROFLO_UENCODED=
AROFLO_PENCODED=
AROFLO_ORG_ENCODED=
# Optional: only if your AroFlo API settings require the sending server's public IP
# AROFLO_HOST_IP=

# true = use built-in sample data instead of calling AroFlo
DEMO_MODE=false

PORT=3000
# Where the user database and cached photos are stored
# DATA_DIR=data
# Set to true when served over HTTPS
# COOKIE_SECURE=true
# Set to 1 when running behind a reverse proxy (IIS, nginx, Azure, etc.)
# TRUST_PROXY=1
# Required on public servers (always on Azure): code needed to create the first admin account
# SETUP_TOKEN=
# Azure App Service sets these automatically; override only if needed
# SQLITE_JOURNAL_MODE=WAL
# Overrides the safety-net check interval set in Portal Settings (minutes, default 60).
# Webhooks trigger syncs as they happen; this only catches missed webhooks.
# SYNC_INTERVAL_MINUTES=60
# Secret part of the AroFlo webhook URL. If unset, one is generated and stored in the database.
# WEBHOOK_SECRET=
# Key for the encrypted ids in URLs and the stored admin 2FA keys (32+ random characters).
# If unset, one is generated and stored in the database. Set it once; changing it breaks
# saved links and every admin's 2FA.
# APP_SECRET=
# AroFlo calls pause for an hour when fewer than this many of today's calls remain (default 200).
# AROFLO_DAILY_RESERVE=200
# Last-resort 2FA recovery: an admin's email here clears their authenticator on start-up.
# Remove it again once they've signed in.
# RESET_2FA_EMAIL=
